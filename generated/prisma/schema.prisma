generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  USER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

model User {
  id       Int      @id @default(autoincrement())
  name     String   @db.VarChar(150)
  email    String   @unique @db.VarChar(255)
  password String   @db.VarChar(255)
  role     UserRole @default(USER)

  bookings      Booking[]
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Genre {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(100)

  movies MovieGenre[]

  @@map("genres")
}

model Movie {
  id              Int       @id @default(autoincrement())
  title           String    @db.VarChar(255)
  description     String?   @db.Text
  durationMinutes Int       @map("duration_minutes")
  posterUrl       String?   @map("poster_url") @db.VarChar(500)
  releaseDate     DateTime? @map("release_date") @db.Date
  isActive        Boolean   @default(true) @map("is_active")

  genres     MovieGenre[]
  screenings Screening[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("movies")
}

model MovieGenre {
  movieId Int @map("movie_id")
  genreId Int @map("genre_id")

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
  @@map("movie_genres")
}

model Hall {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(100)

  seats      Seat[]
  screenings Screening[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("halls")
}

model Seat {
  id         Int     @id @default(autoincrement())
  hallId     Int     @map("hall_id")
  rowNumber  Int     @map("row_number")
  seatNumber Int     @map("seat_number")
  isActive   Boolean @default(true) @map("is_active")

  hall         Hall          @relation(fields: [hallId], references: [id], onDelete: Cascade)
  bookingSeats BookingSeat[]

  @@unique([hallId, rowNumber, seatNumber])
  @@index([hallId])
  @@map("seats")
}

model Screening {
  id        Int      @id @default(autoincrement())
  movieId   Int      @map("movie_id")
  hallId    Int      @map("hall_id")
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  price     Decimal  @db.Decimal(10, 2)

  movie Movie @relation(fields: [movieId], references: [id])
  hall  Hall  @relation(fields: [hallId], references: [id])

  bookings     Booking[]
  bookingSeats BookingSeat[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([movieId])
  @@index([hallId])
  @@index([startTime])
  @@map("screenings")
}

model Booking {
  id          Int           @id @default(autoincrement())
  userId      Int?          @map("user_id")
  screeningId Int           @map("screening_id")
  status      BookingStatus @default(PENDING)
  totalPrice  Decimal       @map("total_price") @db.Decimal(10, 2)

  // guest bookings-ի համար
  guestName  String? @map("guest_name") @db.VarChar(150)
  guestEmail String? @map("guest_email") @db.VarChar(255)
  guestPhone String? @map("guest_phone") @db.VarChar(50)

  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  screening Screening @relation(fields: [screeningId], references: [id])

  seats BookingSeat[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([screeningId])
  @@index([status])
  @@map("bookings")
}

model BookingSeat {
  id          Int     @id @default(autoincrement())
  bookingId   Int     @map("booking_id")
  screeningId Int     @map("screening_id")
  seatId      Int     @map("seat_id")
  price       Decimal @db.Decimal(10, 2)

  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  screening Screening @relation(fields: [screeningId], references: [id], onDelete: Cascade)
  seat      Seat      @relation(fields: [seatId], references: [id])

  // Նույն seat-ը նույն screening-ի մեջ երկրորդ անգամ չի կարող book լինել
  @@unique([screeningId, seatId])
  @@index([bookingId])
  @@index([seatId])
  @@map("booking_seats")
}
